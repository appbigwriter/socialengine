# Modelo SEM segredos. Configurar os valores reais em Environment do Easypanel.
NODE_ENV=production
APP_ENV=production
HOST=0.0.0.0
PORT=3000
SOCIALENGINE_PUBLIC_URL=https://socialengine.fbr.news
SOCIALENGINE_DATA_DIR=/app/data
SOCIALENGINE_WORKER_ENABLED=true
SOCIALENGINE_ALLOW_REGISTRATION=false
SOCIALENGINE_ADMIN_USER_IDS=

CONTROL_TOWER_BASE_URL=https://control-tower.fbr.news
CONTROL_TOWER_PROJECT_ID=6dccc6dd-880f-4148-921a-08cbe8a1f219
CONTROL_TOWER_SCHEMA_NAME=custom_socialengine
DATABASE_URL=
SUPABASE_URL=https://supabase-control-tower-api.fbr.news
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identidade real do catálogo; não gerar um UUID substituto para liberar produção.
AUTHORITY_OWNER_ID=
# Adaptador a alinhar ao Authority; contrato descrito em DEPLOY-EASYPANEL.md.
AUTHORITY_VERIFIER_URL=
AUTHORITY_OPERATOR_TOKEN=
AUTHORITY_ADMIN_TOKEN=
AUTHORITY_REVIEWER_TOKEN=
AUTHORITY_PUBLISHER_TOKEN=
AUTHORITY_VIEWER_TOKEN=
# Gerar uma única chave de 32 bytes, manter em secret manager e preservar no redeploy.
SOCIALENGINE_ENCRYPTION_KEY=

AI_MONTHLY_REQUEST_LIMIT=100
# Opcional: preferir modelo explicitamente configurado por tenant.
OPENAI_MODEL=

# Configurar somente quando os respectivos aplicativos estiverem disponíveis.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
META_GRAPH_VERSION=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PUBLIC_POSTING_APPROVED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
