    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "lucide-react": "1.61.0",
    "pdf-parse": "2.4.5",
    "pg": "8.23.1",
    "react": "19.3.1", "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5", "@types/pg": "8.23.1",
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2", "tsx": "4.23.15", "typescript": "7.0.2", "vite": "8.3.5"
  }
