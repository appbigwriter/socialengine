{
  "name": "socialengine", "version": "0.1.0", "private": true, "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts --sandbox",
    "start": "node --import tsx src/main.ts",
    "worker": "node --import tsx src/worker-main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
